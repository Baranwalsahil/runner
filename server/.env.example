# Database (required)
# Runtime DSN — pooler URL if host fronts Postgres with a transaction-mode
# PgBouncer; otherwise direct DSN.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/territory_run

# Direct DSN (no proxy) — required for migrations + DDL. Optional;
# falls back to DATABASE_URL when unset.
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/territory_run

# JWT (required) — own auth, no third-party identity provider.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-byte-random-hex
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=604800

# Optional infra
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173

# App config
PORT=8000
H3_RESOLUTION=9
NODE_ENV=development
VERSION=0.1.0
